{
  "name": "simple-html-viewer",
  "displayName": "Simple HTML Viewer",
  "description": "A minimal VS Code HTML viewer with interactive webview rendering and independent zoom controls.",
  "version": "0.0.2",
  "publisher": "austin-spagnolo",
  "preview": true,
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/austin-spagnolo/simple-html-viewer.git"
  },
  "homepage": "https://github.com/austin-spagnolo/simple-html-viewer#readme",
  "bugs": {
    "url": "https://github.com/austin-spagnolo/simple-html-viewer/issues"
  },
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "html",
    "preview",
    "webview",
    "plotly",
    "javascript"
  ],
  "galleryBanner": {
    "color": "#1f1f1f",
    "theme": "dark"
  },
  "qna": false,
  "markdown": "github",
  "pricing": "Free",
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "icon": "media/icon.png",
  "activationEvents": [
    "onCommand:simpleHtmlViewer.openPreview",
    "onCustomEditor:simpleHtmlViewer.preview"
  ],
  "contributes": {
    "commands": [
      {
        "command": "simpleHtmlViewer.openPreview",
        "title": "Simple HTML Viewer: Open Preview",
        "category": "Simple HTML Viewer",
        "icon": "$(browser)"
      },
      {
        "command": "simpleHtmlViewer.refreshPreview",
        "title": "Simple HTML Viewer: Refresh Preview",
        "category": "Simple HTML Viewer"
      }
    ],
    "configuration": {
      "title": "Simple HTML Viewer",
      "properties": {
        "simpleHtmlViewer.autoRefresh": {
          "type": "string",
          "enum": [
            "onSave",
            "off"
          ],
          "default": "onSave",
          "markdownDescription": "Controls when the HTML preview refreshes automatically. When set to `off`, the preview shows a toolbar refresh button."
        },
        "simpleHtmlViewer.zoomStep": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 50,
          "description": "Zoom increment, in percent, used by the preview toolbar."
        },
        "simpleHtmlViewer.defaultZoom": {
          "type": "number",
          "default": 100,
          "minimum": 10,
          "maximum": 500,
          "description": "Default zoom percentage for new previews."
        },
        "simpleHtmlViewer.activeContent": {
          "type": "string",
          "enum": [
            "trustedWorkspaces",
            "always",
            "off"
          ],
          "default": "trustedWorkspaces",
          "markdownDescription": "Controls whether previewed HTML can run scripts and load remote resources. `trustedWorkspaces` allows active content only when the workspace is trusted, `always` allows it in every workspace, and `off` blocks page scripts while keeping the preview toolbar active."
        },
        "simpleHtmlViewer.allowInsecureContent": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Allows `http:` and `ws:` resources in active previews. Leave this disabled unless you trust the opened HTML and its network targets."
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "simpleHtmlViewer.openPreview",
          "when": "resourceExtname == .html || resourceExtname == .htm",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "simpleHtmlViewer.openPreview",
          "when": "(resourceExtname == .html || resourceExtname == .htm) && activeCustomEditorId != simpleHtmlViewer.preview",
          "group": "navigation"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "simpleHtmlViewer.preview",
        "displayName": "Simple HTML Viewer",
        "selector": [
          {
            "filenamePattern": "*.html"
          },
          {
            "filenamePattern": "*.htm"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p ./",
    "check": "npm run lint && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts\"",
    "package": "vsce package --githubBranch master",
    "package:vsix": "vsce package --githubBranch master",
    "publish:check": "npm run check && npm run test && npm run test:smoke && npm run test:smoke:vsix",
    "test": "npm run test:unit",
    "test:smoke": "npm run build && node test/smoke/runSmokeTests.js",
    "test:smoke:vsix": "npm run package:vsix && node test/smoke/runSmokeTests.js --vsix",
    "test:smoke:vsix:existing": "node test/smoke/runSmokeTests.js --vsix",
    "test:unit": "npm run build && node test/previewTransform.test.js",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.98.0",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.2",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  }
}
