{
  "name": "simple-html-viewer",
  "displayName": "Simple HTML Viewer",
  "description": "Preview local and remote HTML in VS Code without a server, with optional Integrated Browser routing for local files.",
  "version": "0.1.0",
  "publisher": "austin-spagnolo",
  "preview": true,
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/austin-spagnolo/simple-html-viewer.git"
  },
  "homepage": "https://github.com/austin-spagnolo/simple-html-viewer#readme",
  "bugs": {
    "url": "https://github.com/austin-spagnolo/simple-html-viewer/issues"
  },
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "html",
    "preview",
    "webview",
    "remote-ssh",
    "generated-html",
    "plotly",
    "javascript"
  ],
  "galleryBanner": {
    "color": "#1f1f1f",
    "theme": "dark"
  },
  "qna": false,
  "markdown": "github",
  "pricing": "Free",
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "icon": "media/icon.png",
  "activationEvents": [
    "onCommand:simpleHtmlViewer.openPreview",
    "onCustomEditor:simpleHtmlViewer.preview"
  ],
  "contributes": {
    "commands": [
      {
        "command": "simpleHtmlViewer.openPreview",
        "title": "Open Preview",
        "category": "Simple HTML Viewer",
        "icon": {
          "light": "media/open-preview-light.svg",
          "dark": "media/open-preview-dark.svg"
        }
      },
      {
        "command": "simpleHtmlViewer.refreshPreview",
        "title": "Refresh Preview",
        "category": "Simple HTML Viewer",
        "icon": "$(refresh)"
      },
      {
        "command": "simpleHtmlViewer.zoomIn",
        "title": "Zoom In",
        "category": "Simple HTML Viewer",
        "icon": "$(zoom-in)"
      },
      {
        "command": "simpleHtmlViewer.zoomOut",
        "title": "Zoom Out",
        "category": "Simple HTML Viewer",
        "icon": "$(zoom-out)"
      },
      {
        "command": "simpleHtmlViewer.resetZoom",
        "title": "Reset Zoom",
        "category": "Simple HTML Viewer"
      }
    ],
    "configuration": {
      "title": "Simple HTML Viewer",
      "properties": {
        "simpleHtmlViewer.viewer": {
          "type": "string",
          "enum": [
            "webview",
            "auto",
            "integratedBrowser"
          ],
          "default": "webview",
          "markdownDescription": "Renderer used by Open Preview. `webview` supports local and remote HTML with this extension's controls. `auto` uses Integrated Browser for trusted local workspace files on VS Code 1.133+ unless active content is off; otherwise it uses the webview. `integratedBrowser` explicitly delegates eligible local files on VS Code 1.118.1+ to VS Code, whose security, refresh, and zoom controls replace this extension's settings; unavailable or unsupported cases fall back to the webview. Open With always uses the webview."
        },
        "simpleHtmlViewer.autoRefresh": {
          "type": "string",
          "enum": [
            "onSave",
            "onFileChange",
            "off"
          ],
          "default": "onSave",
          "markdownDescription": "Controls automatic refresh for webview previews. `onSave` refreshes when the HTML file is saved in VS Code. `onFileChange` also watches an open preview's HTML file for external rewrites. `off` disables automatic refresh. Refresh Preview in the editor title is always available. Integrated Browser tabs use VS Code's own reload setting."
        },
        "simpleHtmlViewer.zoomStep": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 50,
          "description": "Zoom increment, in percent, for webview preview commands."
        },
        "simpleHtmlViewer.defaultZoom": {
          "type": "number",
          "default": 100,
          "minimum": 10,
          "maximum": 500,
          "description": "Default zoom percentage for new webview previews."
        },
        "simpleHtmlViewer.activeContent": {
          "type": "string",
          "enum": [
            "trustedWorkspaces",
            "always",
            "off"
          ],
          "default": "trustedWorkspaces",
          "markdownDescription": "Controls whether webview previews can run page scripts and load remote resources. `trustedWorkspaces` permits active content only in trusted workspaces; `always` permits it everywhere; `off` blocks page scripts. Explicit Integrated Browser selection follows VS Code's own policy."
        },
        "simpleHtmlViewer.allowInsecureContent": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Allows `http:` and `ws:` resources in active webview previews. Leave this disabled unless you trust the HTML and its network targets. Explicit Integrated Browser selection follows VS Code's own policy."
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "simpleHtmlViewer.openPreview",
          "when": "resourceExtname == .html || resourceExtname == .htm",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "simpleHtmlViewer.openPreview",
          "when": "(resourceExtname == .html || resourceExtname == .htm) && activeCustomEditorId != simpleHtmlViewer.preview",
          "group": "navigation"
        },
        {
          "command": "simpleHtmlViewer.zoomOut",
          "when": "activeCustomEditorId == simpleHtmlViewer.preview",
          "group": "navigation@1"
        },
        {
          "command": "simpleHtmlViewer.zoomIn",
          "when": "activeCustomEditorId == simpleHtmlViewer.preview",
          "group": "navigation@2"
        },
        {
          "command": "simpleHtmlViewer.refreshPreview",
          "when": "activeCustomEditorId == simpleHtmlViewer.preview",
          "group": "navigation@3"
        },
        {
          "command": "simpleHtmlViewer.resetZoom",
          "when": "activeCustomEditorId == simpleHtmlViewer.preview",
          "group": "1_modification"
        }
      ]
    },
    "keybindings": [
      {
        "command": "simpleHtmlViewer.zoomIn",
        "key": "ctrl+=",
        "mac": "cmd+=",
        "when": "activeCustomEditorId == simpleHtmlViewer.preview && editorAreaFocus"
      },
      {
        "command": "simpleHtmlViewer.zoomOut",
        "key": "ctrl+-",
        "mac": "cmd+-",
        "when": "activeCustomEditorId == simpleHtmlViewer.preview && editorAreaFocus"
      },
      {
        "command": "simpleHtmlViewer.resetZoom",
        "key": "ctrl+0",
        "mac": "cmd+0",
        "when": "activeCustomEditorId == simpleHtmlViewer.preview && editorAreaFocus"
      }
    ],
    "customEditors": [
      {
        "viewType": "simpleHtmlViewer.preview",
        "displayName": "HTML Preview",
        "selector": [
          {
            "filenamePattern": "*.html"
          },
          {
            "filenamePattern": "*.htm"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p ./",
    "check": "npm run lint && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts\"",
    "package": "vsce package --githubBranch master",
    "package:vsix": "vsce package --githubBranch master",
    "publish:check": "npm run check && npm run test && npm run test:smoke && npm run test:smoke:vsix",
    "test": "npm run test:unit",
    "test:smoke": "npm run build && node test/smoke/runSmokeTests.js",
    "test:smoke:vsix": "npm run package:vsix && node test/smoke/runSmokeTests.js --vsix",
    "test:smoke:vsix:existing": "node test/smoke/runSmokeTests.js --vsix",
    "test:unit": "npm run build && node test/previewTransform.test.js && node test/viewerRouter.test.js && node test/previewProvider.test.js",
    "vscode:prepublish": "npm run build",
    "test:release": "node --test .github/scripts/publish-registry.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.98.0",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.2",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.0.1",
    "ovsx": "1.2.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  }
}
